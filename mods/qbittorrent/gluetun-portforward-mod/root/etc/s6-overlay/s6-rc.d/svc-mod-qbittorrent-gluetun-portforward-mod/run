#!/usr/bin/with-contenv bash
# shellcheck shell=bash
#===============================================================================
# qbittorrent-gluetun-portforward-mod
#
# Polls gluetun's control server for the currently forwarded VPN port and keeps
# qBittorrent's listening port in sync through its WebUI API.
#
# Design constraints, deliberately chosen:
#
#  * No `set -e`, no `set -u`, no `set -o pipefail`. This is a supervised s6
#    longrun that must never terminate on a transient error; `set -e` here would
#    turn one failed curl into an s6-supervise hot restart loop. Instead every
#    fallible call is checked explicitly and every global is initialised below,
#    with shellcheck in CI catching what `set -u` would have.
#
#  * Writes nothing to disk. qBittorrent owns qBittorrent.conf and rewrites it
#    from memory on exit, so editing it under a running client loses the edit;
#    the WebUI API is the only correct way in. That also makes
#    LSIO_READ_ONLY_FS a non-event.
#
#  * Runs as the container's default identity: no s6-setuidgid, no lsiown. We
#    create no files, so there is no ownership to get wrong, and this keeps
#    LSIO_NON_ROOT_USER working with zero special-casing.
#
#  * All state lives in shell variables. A restart is always safe: the loop
#    re-reads qBittorrent's actual preferences and re-converges.
#===============================================================================

MOD="gluetun-portforward"
P="[mod-${MOD}]"

readonly MIN_PUT_GAP=5 # hard floor, seconds, between two writes
readonly CONNECT_TIMEOUT=5

# gluetun routes, most-current first. /v1/openvpn/portforwarded is native on
# <= v3.40.4 and 301-redirects to /v1/portforward on >= v3.41.0, so this pair
# covers every released gluetun.
readonly GT_PATHS=("/v1/portforward" "/v1/openvpn/portforwarded")

#-------------------------------------------------------------------------------
# Mutable state. Everything is initialised here so nothing is ever unset.
#
# IMPORTANT: functions that mutate any of these must never be called inside
# $( ) -- a command substitution runs in a subshell and silently discards every
# assignment. Only extract_ports(), json_num(), json_bool() and normalise_url()
# print to stdout, and none of those touch state.
#-------------------------------------------------------------------------------
GT_PATH="" # learned-and-sticky working gluetun route
GT_PORT=""
GT_ALL=""
GT_STATUS=""
GT_VERSION_LOGGED=0
QBT_COOKIE="" # SID cookie, empty when relying on the localhost bypass
QBT_AUTH_MODE=""
LAST_PUSHED="" # last port this process successfully wrote
LAST_PUT_AT=0  # $SECONDS at last write
FORCE_RESYNC=0 # see the note in main(): re-apply after a port outage
HTTP_CODE=""
HTTP_BODY=""
HTTP_RC=0
TERMINATE=0
_sleep_pid=""
declare -A _st=()

#-------------------------------------------------------------------------------
# Logging and small predicates
#-------------------------------------------------------------------------------
log() { echo "${P} $*"; }
loud() { echo "${P} **** $* ****"; }
dbg() {
    [[ ${LOG_LEVEL,,} == "debug" ]] && echo "${P} [debug] $*"
    return 0
}

# state <key> <value> -> returns 0 exactly once per value change.
# Transitions are loud, steady state is silent. A mod that prints a line every
# 60s forever is a mod users mute.
state() {
    if [[ ${_st[$1]-__unset__} != "$2" ]]; then
        _st[$1]="$2"
        return 0
    fi
    return 1
}

# NOTE: ./finish repeats this same falsey list. Keep the two in sync.
falsey() { [[ ${1,,} =~ ^(0|false|no|off|disable|disabled)$ ]]; }
truthy() { [[ ! ${1,,} =~ ^(0|false|no|off|disable|disabled)$ ]]; }
is_uint() { [[ $1 =~ ^[0-9]+$ ]]; }

#-------------------------------------------------------------------------------
# The netns watchdog, sourced rather than inlined so it can be unit-tested and so
# the two gluetun-portforward mods share one copy of it verbatim.
#
# Sourced HERE, after log/loud/truthy/is_uint exist, so the helper binds to this
# mod's real logging rather than to its own fallbacks -- but still before
# configure(), which is what arms it.
#
# Default off. Absent the helper, or with GLUETUN_PF_NETNS_WATCHDOG unset, the
# stubs below make netns_watchdog_check a no-op and this file behaves exactly as
# it did before the feature existed.
#-------------------------------------------------------------------------------
# Overridable only through the mod's own prefix: this script runs under
# with-contenv, so every container variable is in scope, and an unprefixed name
# here would mean an unrelated variable could decide which file we source as root.
NETNS_WATCHDOG_LIB="${GLUETUN_PF_NETNS_WATCHDOG_LIB:-/usr/local/lib/mod-gluetun-portforward/netns-watchdog.sh}"
if [[ -r ${NETNS_WATCHDOG_LIB} ]]; then
    # shellcheck source-path=SCRIPTDIR
    # shellcheck source=../../../../usr/local/lib/mod-gluetun-portforward/netns-watchdog.sh
    . "${NETNS_WATCHDOG_LIB}"
fi
# Defence in depth: a partial overlay must not break the poll loop.
if ! declare -F netns_watchdog_check >/dev/null 2>&1; then
    netns_watchdog_configure() { NETNS_WATCHDOG=0; }
    netns_watchdog_enabled() { return 1; }
    netns_watchdog_check() { return 0; }
fi

curl_hint() {
    case ${1} in
        0) echo "no error" ;;
        6) echo "could not resolve host" ;;
        7) echo "connection refused" ;;
        28) echo "timed out" ;;
        52) echo "empty reply from server" ;;
        56) echo "connection reset" ;;
        *) echo "curl exit ${1}" ;;
    esac
}

normalise_url() {
    local u=$1
    [[ ${u} != *://* ]] && u="http://${u}"
    while [[ ${u} == */ ]]; do u="${u%/}"; done
    printf '%s' "${u}"
}

#-------------------------------------------------------------------------------
# configure(): everything env-derived lives here so ./run can be sourced by the
# unit tests without side effects.
#-------------------------------------------------------------------------------
configure() {
    CONTROL_URL="$(normalise_url "${GLUETUN_PF_CONTROL_URL:-http://localhost:8000}")"
    APIKEY="${GLUETUN_PF_APIKEY:-}"
    GT_USER="${GLUETUN_PF_USERNAME:-}"
    GT_PASS="${GLUETUN_PF_PASSWORD:-}"
    PORT_INDEX="${GLUETUN_PF_PORT_INDEX:-0}"
    # The image launches qbittorrent-nox with --webui-port="${WEBUI_PORT:-8080}",
    # so default to wherever the app is actually listening.
    QBT_URL="$(normalise_url "${GLUETUN_PF_QBT_URL:-http://localhost:${WEBUI_PORT:-8080}}")"
    QBT_USER="${GLUETUN_PF_QBT_USERNAME:-}"
    QBT_PASS="${GLUETUN_PF_QBT_PASSWORD:-}"
    MANAGE_TOGGLES="${GLUETUN_PF_MANAGE_PORT_TOGGLES:-true}"
    INTERVAL="${GLUETUN_PF_INTERVAL:-60}"
    RETRY_INTERVAL="${GLUETUN_PF_RETRY_INTERVAL:-10}"
    TIMEOUT="${GLUETUN_PF_TIMEOUT:-10}"
    LOG_LEVEL="${GLUETUN_PF_LOG_LEVEL:-info}"

    # Clamp rather than fail. Refusing to run because someone typed "60s"
    # instead of "60" is the wrong call for a background mod.
    if ! is_uint "${INTERVAL}" || ((INTERVAL < 5)); then
        loud "GLUETUN_PF_INTERVAL='${INTERVAL}' is not a number >= 5, using 60"
        INTERVAL=60
    fi
    if ! is_uint "${RETRY_INTERVAL}" || ((RETRY_INTERVAL < 2)); then
        loud "GLUETUN_PF_RETRY_INTERVAL='${RETRY_INTERVAL}' is not a number >= 2, using 10"
        RETRY_INTERVAL=10
    fi
    if ! is_uint "${TIMEOUT}" || ((TIMEOUT < 2)); then
        TIMEOUT=10
    fi
    if ! is_uint "${PORT_INDEX}"; then
        loud "GLUETUN_PF_PORT_INDEX='${PORT_INDEX}' is not a number, using 0 (lowest port)"
        PORT_INDEX=0
    fi

    GT_AUTH=()
    GT_AUTH_DESC="none"
    if [[ -n ${APIKEY} ]]; then
        GT_AUTH=(-H "X-API-Key: ${APIKEY}")
        GT_AUTH_DESC="X-API-Key header"
        if [[ -n ${GT_USER}${GT_PASS} ]]; then
            log "both GLUETUN_PF_APIKEY and GLUETUN_PF_USERNAME/PASSWORD are set; using the API key"
        fi
    elif [[ -n ${GT_USER}${GT_PASS} ]]; then
        GT_AUTH=(--user "${GT_USER}:${GT_PASS}")
        GT_AUTH_DESC="HTTP basic as '${GT_USER}'"
    fi

    if [[ -n ${QBT_USER} ]]; then
        QBT_AUTH_MODE="login as '${QBT_USER}'"
    else
        QBT_AUTH_MODE="none (relies on qBittorrent's localhost auth bypass)"
    fi

    netns_watchdog_configure
}

#-------------------------------------------------------------------------------
# The HTTP primitive. Sets HTTP_CODE, HTTP_BODY, HTTP_RC.
#
# Every flag defends against a specific real failure:
#   --noproxy '*'   a stray HTTP_PROXY in the container's environment would
#                   route http://localhost:8080 through it and return an
#                   inexplicable 502. Both our targets are container-local.
#   -g              globoff, so a bracketed IPv6 literal is not parsed as a glob.
#   -s without -S   we generate our own error text from HTTP_RC, so curl's
#                   stderr never interleaves with the body or spams the log.
#   --*-timeout     the loop can never hang.
#   -w http_code    curl emits the write-out even on connection failure, where
#                   %{http_code} is 000. That gives a clean three-way split:
#                   000 = no answer (consult HTTP_RC), 4xx/5xx = answered badly,
#                   2xx = fine.
#
# Deliberately no Referer or Origin header on the qBittorrent calls. Its CSRF
# check rejects a *mismatched* origin but explicitly permits a request carrying
# neither -- the source comment says blocking those "will inevitably lead Web
# API users to spoof headers" -- so sending nothing is simpler and safer than
# guessing a value that has to equal the Host header.
#-------------------------------------------------------------------------------
http_req() {
    local url=$1
    shift
    local out
    out="$(curl -s -g --noproxy '*' \
        --connect-timeout "${CONNECT_TIMEOUT}" --max-time "${TIMEOUT}" \
        -w '\n%{http_code}' "$@" "${url}" 2>/dev/null)"
    HTTP_RC=$?
    HTTP_CODE="${out##*$'\n'}"
    HTTP_BODY="${out%$'\n'*}"
    [[ ${HTTP_CODE} =~ ^[0-9]{3}$ ]] || HTTP_CODE="000"
    return 0
}

#-------------------------------------------------------------------------------
# gluetun: parse
#
# The response shape changed three times across gluetun releases:
#   <= v3.38.0        {"port":N}                       (/v1/openvpn/portforwarded)
#   v3.39.0-v3.41.1   0 ports -> {"port":0}
#                     1 port  -> {"port":N}
#                     2+      -> {"ports":[N,M]}  <- no "port" key at all
#   v3.41.2+          {"port":N,"ports":[N]}           (port == ports[0])
#
# So we emit the LIST and let the caller classify. The obvious
# `jq -r '(.ports // []|.[0]) // .port // 0'` collapses "port is 0", "list is
# empty" and "body is not JSON" into the same 0, and those need different
# handling.
#
# Runs under process substitution, so it must not set globals.
#-------------------------------------------------------------------------------
extract_ports() {
    if command -v jq >/dev/null 2>&1; then
        printf '%s' "$1" | jq -r '
            if (.ports? | type) == "array" then .ports[]
            elif (.port? | type) == "number" then .port
            else empty end' 2>/dev/null
        return 0
    fi
    # jq-less fallback. Not expected on a linuxserver image -- /docker-mods
    # itself parses registry manifests with jq, so if jq were missing this mod
    # could not have been extracted into the container at all.
    # The literal pattern "port" requires the closing quote immediately after
    # port, which "ports" does not provide, so there is no collision.
    local list p
    list="$(printf '%s' "$1" | sed -n 's/.*"ports"[[:space:]]*:[[:space:]]*\[\([^]]*\)\].*/\1/p')"
    if [[ -n ${list} ]]; then
        printf '%s\n' "${list}" | tr ',' '\n' | tr -d ' "'
        return 0
    fi
    p="$(printf '%s' "$1" | sed -n 's/.*"port"[[:space:]]*:[[:space:]]*\([0-9][0-9]*\).*/\1/p')"
    [[ -n ${p} ]] && printf '%s\n' "${p}"
    return 0
}

# gluetun_select_port <json>; sets GT_PORT, GT_ALL
#   0 = usable port found
#   1 = valid JSON, no usable port (not ready -- a normal steady state)
#   2 = body is not JSON we understand
gluetun_select_port() {
    GT_PORT=""
    GT_ALL=""
    if command -v jq >/dev/null 2>&1; then
        printf '%s' "$1" | jq -e . >/dev/null 2>&1 || return 2
    else
        [[ $1 == *'{'* ]] || return 2
    fi

    local -a all=() good=()
    local p
    mapfile -t all < <(extract_ports "$1")
    for p in "${all[@]}"; do
        is_uint "${p}" || continue
        ((p > 0 && p < 65536)) || continue
        good+=("${p}")
    done
    ((${#good[@]})) || return 1

    # gluetun already sorts ascending; sorting ourselves removes the assumption
    # and makes GLUETUN_PF_PORT_INDEX stable across gluetun versions.
    mapfile -t good < <(printf '%s\n' "${good[@]}" | sort -n)

    local idx=${PORT_INDEX}
    if ((idx >= ${#good[@]})); then
        idx=0
    fi
    GT_PORT="${good[${idx}]}"
    GT_ALL="${good[*]}"
    return 0
}

#-------------------------------------------------------------------------------
# gluetun: probe. Sets GT_STATUS to one of
# ok | notready | auth | unavailable | badresponse | unreachable
#-------------------------------------------------------------------------------
gluetun_probe() {
    local -a paths
    local path saw_auth=0 rc
    if [[ -n ${GT_PATH} ]]; then paths=("${GT_PATH}"); else paths=("${GT_PATHS[@]}"); fi

    for path in "${paths[@]}"; do
        http_req "${CONTROL_URL}${path}" -L "${GT_AUTH[@]}"
        case ${HTTP_CODE} in
            200)
                GT_PATH="${path}"
                gluetun_select_port "${HTTP_BODY}"
                rc=$?
                case ${rc} in
                    0) GT_STATUS="ok" ;;
                    1) GT_STATUS="notready" ;;
                    *) GT_STATUS="badresponse" ;;
                esac
                return 0
                ;;
            401)
                # CRITICAL: gluetun v3.39.1 .. v3.40.4 answers 401 for
                # /v1/portforward because the route does not exist there, so no
                # role can possibly cover it. A 401 is therefore NOT proof of an
                # auth problem until every candidate route has been tried.
                saw_auth=1
                ;;
            000)
                GT_STATUS="unreachable"
                return 0
                ;;
            *) : ;; # 400/404/405/5xx -> route missing or broken, try the next
        esac
    done

    # A previously working route stopped working: relearn from scratch.
    GT_PATH=""
    if ((saw_auth)); then GT_STATUS="auth"; else GT_STATUS="unavailable"; fi
    return 0
}

# Advisory only -- nothing is gated on /v1/version, because a user whose
# config.toml has a role covering only GET /v1/portforward gets 401 here while
# the mod works perfectly.
#
# This clobbers HTTP_*, so it is called ONLY from the `ok` branch, after GT_PORT
# has already been extracted and before sync_qbt issues fresh requests.
gluetun_log_version() {
    ((GT_VERSION_LOGGED)) && return 0
    GT_VERSION_LOGGED=1
    local v=""
    http_req "${CONTROL_URL}/v1/version" -L "${GT_AUTH[@]}"
    if [[ ${HTTP_CODE} == 200 ]] && command -v jq >/dev/null 2>&1; then
        v="$(printf '%s' "${HTTP_BODY}" | jq -r '.version // empty' 2>/dev/null)"
    fi
    if [[ -n ${v} ]]; then
        log "gluetun ${v}, using route ${GT_PATH}"
    else
        log "gluetun version probe returned ${HTTP_CODE} (harmless); using route ${GT_PATH}"
    fi
    return 0
}

print_gt_auth_help() {
    loud "gluetun returned 401 Unauthorized on every known port-forward route"
    log "  -> gluetun only serves GET /v1/portforward without credentials while its auth config has NO roles."
    log "     Mounting a config.toml with even one role removes ALL public defaults."
    log "  -> add a role covering BOTH routes (the legacy route 301-redirects and re-enters auth):"
    log "       [[roles]]"
    log "       name = \"qbittorrent-portforward-mod\""
    log "       routes = [\"GET /v1/portforward\", \"GET /v1/openvpn/portforwarded\", \"GET /v1/version\"]"
    log "       auth = \"apikey\""
    log "       apikey = \"<docker run --rm qmcgaw/gluetun genkey>\""
    log "  -> mount it at /gluetun/auth/config.toml on the gluetun container, then set GLUETUN_PF_APIKEY"
    log "     to the same value here (or GLUETUN_PF_USERNAME/GLUETUN_PF_PASSWORD for basic auth)."
    log "  -> if your gluetun predates v3.41 this can also mean the routes genuinely do not exist; check its version."
}

print_gt_unreachable_help() {
    loud "cannot reach gluetun's control server at ${CONTROL_URL} ($(curl_hint "${HTTP_RC}"))"
    case ${HTTP_RC} in
        7) log "  -> connection refused: is gluetun running, and is its control server listening? (HTTP_CONTROL_SERVER_ADDRESS, default :8000)" ;;
        28)
            log "  -> timed out rather than refused. Either the hostname is wrong (docker's DNS makes that look like a timeout, not a DNS error), or packets are being dropped."
            log "     With network_mode: service:gluetun use http://localhost:8000; on a shared bridge network use http://gluetun:8000 and set FIREWALL_INPUT_PORTS=8000 on gluetun."
            ;;
        6) log "  -> hostname does not resolve. With network_mode: service:gluetun use http://localhost:8000; on a shared bridge network use http://gluetun:8000." ;;
        *) : ;;
    esac
}

#-------------------------------------------------------------------------------
# qBittorrent helpers
#-------------------------------------------------------------------------------
# json_num  <json> <key> -> prints an integer value, or nothing.
# json_bool <json> <key> -> prints true/false, or nothing.
# `numbers` and `booleans` are jq type filters, so a missing key or a value of
# the wrong type yields nothing rather than the string "null".
json_num() {
    if command -v jq >/dev/null 2>&1; then
        printf '%s' "$1" | jq -r --arg k "$2" '.[$k] | numbers' 2>/dev/null
        return 0
    fi
    printf '%s' "$1" | sed -n 's/.*"'"$2"'"[[:space:]]*:[[:space:]]*\([0-9][0-9]*\).*/\1/p'
}

json_bool() {
    if command -v jq >/dev/null 2>&1; then
        printf '%s' "$1" | jq -r --arg k "$2" '.[$k] | booleans' 2>/dev/null
        return 0
    fi
    printf '%s' "$1" | sed -n 's/.*"'"$2"'"[[:space:]]*:[[:space:]]*\(true\|false\).*/\1/p'
}

# qBittorrent answers once its WebUI is listening. /api/v2/app/version needs
# auth, but even its 403 proves the server is up, which is all we ask here.
qbt_up() {
    http_req "${QBT_URL}/api/v2/app/version"
    [[ ${HTTP_CODE} != "000" ]]
}

# Obtain a SID cookie. Only meaningful when credentials were supplied; without
# them we rely on qBittorrent's localhost bypass and send no cookie at all.
qbt_login() {
    QBT_COOKIE=""
    [[ -z ${QBT_USER} ]] && return 0

    http_req "${QBT_URL}/api/v2/auth/login" -D - \
        --data-urlencode "username=${QBT_USER}" \
        --data-urlencode "password=${QBT_PASS}"
    if [[ ${HTTP_CODE} != 200 ]]; then
        state qbtlogin "http:${HTTP_CODE}" &&
            loud "qBittorrent login failed (HTTP ${HTTP_CODE})"
        return 1
    fi
    # A wrong password still returns 200, with "Fails." as the body.
    if [[ ${HTTP_BODY} == *"Fails."* ]]; then
        state qbtlogin fails && {
            loud "qBittorrent rejected the credentials in GLUETUN_PF_QBT_USERNAME/PASSWORD"
            log "  -> qBittorrent 4.6.1+ generates a NEW temporary admin password on every start unless"
            log "     you set a permanent one in the WebUI, so a temporary password cannot be used here."
        }
        return 1
    fi
    QBT_COOKIE="$(printf '%s' "${HTTP_BODY}" |
        sed -n 's/.*[Ss][Ee][Tt]-[Cc][Oo][Oo][Kk][Ii][Ee]:[[:space:]]*\(SID=[^;]*\).*/\1/p' | head -n1)"
    if [[ -z ${QBT_COOKIE} ]]; then
        state qbtlogin nocookie && loud "qBittorrent accepted the login but returned no SID cookie"
        return 1
    fi
    state qbtlogin ok && log "authenticated to qBittorrent as '${QBT_USER}'"
    return 0
}

# Run a qBittorrent API call, carrying the session cookie when we have one.
qbt_req() {
    local path=$1
    shift
    if [[ -n ${QBT_COOKIE} ]]; then
        http_req "${QBT_URL}${path}" -H "Cookie: ${QBT_COOKIE}" "$@"
    else
        http_req "${QBT_URL}${path}" "$@"
    fi
}

print_qbt_forbidden_help() {
    loud "qBittorrent refused the request (HTTP 403 Forbidden)"
    log "  -> it needs either credentials or its localhost bypass. Pick one:"
    log "     a) In the WebUI, Tools > Options > Web UI, tick 'Bypass authentication"
    log "        for clients on localhost'. This mod talks to loopback, so that is"
    log "        enough and keeps secrets out of your compose file."
    log "     b) Set a permanent WebUI password, then pass it as"
    log "        GLUETUN_PF_QBT_USERNAME and GLUETUN_PF_QBT_PASSWORD."
    log "  -> the temporary admin password printed on start is regenerated every"
    log "     restart, so it cannot be used for (b)."
}

#-------------------------------------------------------------------------------
# sync_qbt <port> -- the only thing in this mod that writes.
#
# Reads the live preferences every poll rather than trusting memory, which is
# what makes the mod self-heal after someone changes the port by hand or
# restores a config from backup.
#-------------------------------------------------------------------------------
sync_qbt() {
    local want=$1
    local cur_port cur_random cur_upnp need=0 reason="" payload

    qbt_req "/api/v2/app/preferences"
    case ${HTTP_CODE} in
        200) : ;;
        403)
            # Either the session expired or we never had one. Re-login if we
            # can; otherwise this is a configuration problem, said once.
            QBT_COOKIE=""
            if [[ -n ${QBT_USER} ]]; then
                state qbtauth expired && log "qBittorrent session rejected; logging in again"
                qbt_login
            else
                state qbtauth forbidden && print_qbt_forbidden_help
            fi
            return 1
            ;;
        000)
            log "qBittorrent went away while reading preferences ($(curl_hint "${HTTP_RC}"))"
            return 1
            ;;
        *)
            state qbtread "http:${HTTP_CODE}" &&
                loud "unexpected HTTP ${HTTP_CODE} reading qBittorrent preferences: ${HTTP_BODY:0:200}"
            return 1
            ;;
    esac
    state qbtauth ok >/dev/null

    cur_port="$(json_num "${HTTP_BODY}" listen_port)"
    cur_random="$(json_bool "${HTTP_BODY}" random_port)"
    cur_upnp="$(json_bool "${HTTP_BODY}" upnp)"

    [[ ${cur_port} == "${want}" ]] || {
        need=1
        reason+="listen_port ${cur_port:-?}->${want} "
    }
    if truthy "${MANAGE_TOGGLES}"; then
        # A forwarded port is pointless if qBittorrent then picks a random one,
        # and UPnP would try to map a port on the VPN gateway, which is not a
        # router that will answer.
        [[ ${cur_random} == "false" ]] || {
            need=1
            reason+="random_port ${cur_random:-?}->false "
        }
        [[ ${cur_upnp} == "false" ]] || {
            need=1
            reason+="upnp ${cur_upnp:-?}->false "
        }
    fi

    # qBittorrent does not reliably re-open the listener after the tunnel drops,
    # so a port that comes back unchanged still needs writing once. FORCE_RESYNC
    # is armed when the port goes away, and cleared by a successful write.
    if ((!need)) && ((FORCE_RESYNC)); then
        need=1
        reason="re-applying ${want} after a port outage"
    fi

    if ((!need)); then
        dbg "already in sync: listen_port=${want} random_port=${cur_random} upnp=${cur_upnp}"
        LAST_PUSHED="${want}"
        return 0
    fi

    if ((LAST_PUT_AT > 0 && SECONDS - LAST_PUT_AT < MIN_PUT_GAP)); then
        dbg "update deferred, previous write was $((SECONDS - LAST_PUT_AT))s ago"
        return 1
    fi

    payload="{\"listen_port\":${want}"
    if truthy "${MANAGE_TOGGLES}"; then
        payload+=",\"random_port\":false,\"upnp\":false"
    fi
    payload+="}"

    log "updating qBittorrent: ${reason}"
    # The body is form-encoded with a single `json` field holding the object --
    # not a raw JSON body, which qBittorrent ignores.
    qbt_req "/api/v2/app/setPreferences" --data-urlencode "json=${payload}"
    LAST_PUT_AT=${SECONDS}

    case ${HTTP_CODE} in
        200)
            loud "qBittorrent listening port is now ${want}"
            LAST_PUSHED="${want}"
            FORCE_RESYNC=0
            return 0
            ;;
        403)
            QBT_COOKIE=""
            if [[ -n ${QBT_USER} ]]; then
                log "qBittorrent session rejected while writing; logging in again"
                qbt_login
            else
                state qbtauth forbidden && print_qbt_forbidden_help
            fi
            return 1
            ;;
        000)
            log "qBittorrent went away while writing preferences ($(curl_hint "${HTTP_RC}"))"
            return 1
            ;;
        *)
            loud "unexpected HTTP ${HTTP_CODE} writing qBittorrent preferences: ${HTTP_BODY:0:200}"
            return 1
            ;;
    esac
}

#-------------------------------------------------------------------------------
# Interruptible sleep. A foreground `sleep` defers traps until it finishes,
# which would make `docker stop` block for its whole grace period and then
# SIGKILL us on every stack restart.
#-------------------------------------------------------------------------------
_on_term() {
    TERMINATE=1
    [[ -n ${_sleep_pid} ]] && kill "${_sleep_pid}" 2>/dev/null
    return 0
}
trap _on_term TERM INT

_sleep() {
    sleep "$1" &
    _sleep_pid=$!
    wait "${_sleep_pid}" 2>/dev/null
    _sleep_pid=""
    if ((TERMINATE)); then
        log "shutting down"
        exit 0
    fi
    return 0
}

#-------------------------------------------------------------------------------
# main
#-------------------------------------------------------------------------------
main() {
    loud "starting"
    log "gluetun control server : ${CONTROL_URL}"
    log "gluetun auth           : ${GT_AUTH_DESC}"
    log "qbittorrent            : ${QBT_URL}"
    log "qbittorrent auth       : ${QBT_AUTH_MODE}"
    log "poll interval          : ${INTERVAL}s (retry ${RETRY_INTERVAL}s, request timeout ${TIMEOUT}s)"
    if truthy "${MANAGE_TOGGLES}"; then
        log "random_port / upnp     : forced off"
    else
        log "random_port / upnp     : left alone"
    fi
    if netns_watchdog_enabled; then
        if ((NETNS_DRY_RUN)); then
            log "netns watchdog         : DRY RUN, ${NETNS_STRIKES_MAX} strikes, ${NETNS_GRACE}s grace (logs the decision, halts nothing)"
        else
            log "netns watchdog         : armed, ${NETNS_STRIKES_MAX} strikes, ${NETNS_GRACE}s grace, halts with exit ${NETNS_EXIT_CODE}"
            log "  -> needs 'restart: unless-stopped' on this container, or halting it is not a recovery"
        fi
    fi

    local unreachable_streak=0

    while ((!TERMINATE)); do
        # FIRST, before any request. Once the namespace is dead every port-sync
        # attempt fails anyway, so checking later would bury the diagnosis under
        # a wall of connection errors. Off by default; never returns if it halts.
        netns_watchdog_check

        if ! qbt_up; then
            state qbt down && loud "waiting for qBittorrent to answer on ${QBT_URL} ($(curl_hint "${HTTP_RC}"))"
            _sleep "${RETRY_INTERVAL}"
            continue
        fi
        if state qbt up; then
            log "qBittorrent is answering on ${QBT_URL}"
            # A fresh WebUI means a fresh session; get one before the first read.
            qbt_login
        fi

        gluetun_probe
        case ${GT_STATUS} in
            ok)
                unreachable_streak=0
                state gt ok && log "gluetun control server reachable at ${CONTROL_URL}${GT_PATH}"
                gluetun_log_version
                if state gtport "${GT_PORT}"; then
                    if [[ ${GT_ALL} != "${GT_PORT}" ]]; then
                        loud "gluetun forwarded port: ${GT_PORT} (all: ${GT_ALL})"
                    else
                        loud "gluetun forwarded port: ${GT_PORT}"
                    fi
                fi
                sync_qbt "${GT_PORT}"
                _sleep "${INTERVAL}"
                ;;
            notready)
                unreachable_streak=0
                # Arm the re-apply. qBittorrent can come back holding the right
                # number in its settings and still not be listening on it, so
                # the next port we see gets written even if it matches.
                FORCE_RESYNC=1
                state gt notready && {
                    loud "gluetun reports no forwarded port yet"
                    log "  -> leaving qBittorrent's listening port unchanged${LAST_PUSHED:+ (last value we set: ${LAST_PUSHED})}"
                }
                _sleep "${INTERVAL}"
                ;;
            auth)
                unreachable_streak=0
                state gt auth && print_gt_auth_help
                _sleep "${INTERVAL}"
                ;;
            badresponse)
                unreachable_streak=0
                state gt badresponse &&
                    loud "gluetun answered 200 on ${GT_PATH} but the body is not JSON we understand: ${HTTP_BODY:0:200}"
                _sleep "${INTERVAL}"
                ;;
            unavailable)
                unreachable_streak=0
                state gt unavailable && {
                    loud "gluetun's control server answered, but none of '${GT_PATHS[*]}' exist (last HTTP ${HTTP_CODE})"
                    log "  -> gluetun <= v3.38 exposes GET /v1/openvpn/portforwarded; >= v3.41 exposes GET /v1/portforward. Both are tried."
                    log "  -> check that GLUETUN_PF_CONTROL_URL really points at gluetun's control server (default port 8000)."
                }
                _sleep "${INTERVAL}"
                ;;
            *)
                # Converge fast while gluetun is merely booting, then relax so a
                # permanently wrong URL does not retry every 10s forever.
                FORCE_RESYNC=1
                unreachable_streak=$((unreachable_streak + 1))
                state gt "unreachable:${HTTP_RC}" && print_gt_unreachable_help
                if ((unreachable_streak > 6)); then
                    _sleep "${INTERVAL}"
                else
                    _sleep "${RETRY_INTERVAL}"
                fi
                ;;
        esac
    done
}

#-------------------------------------------------------------------------------
# Entry point
#-------------------------------------------------------------------------------
# Sourced by test/run_tests.sh: define everything, run nothing.
[[ -n ${GLUETUN_PF_LIB_ONLY:-} ]] && return 0

# The `sleep 2` before each intentional exit is the anti-hot-loop measure. The
# main loop is structurally incapable of exiting -- no set -e, no exit outside
# these gates and the SIGTERM path -- but a future edit could introduce a bash
# runtime error, and ./finish's duplicated falsey check could disagree with
# ours. ./finish throttles unexpected exits; these two throttle the intended
# ones.
if falsey "${GLUETUN_PF_ENABLED:-true}"; then
    echo "${P} **** GLUETUN_PF_ENABLED='${GLUETUN_PF_ENABLED}', this mod will stay inert ****"
    sleep 2
    exit 0
fi

if ! command -v curl >/dev/null 2>&1; then
    echo "${P} **** curl is not present in this image, cannot continue ****"
    sleep 2
    exit 0
fi

configure
main
